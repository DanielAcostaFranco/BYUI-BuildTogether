# Copy this file to .env and replace the placeholders with your Atlas values.
# Never commit .env or paste this connection string into a Svelte component.
MONGODB_USERNAME=your_atlas_database_username
MONGODB_PASSWORD=your_atlas_database_password
MONGODB_URI=mongodb+srv://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@<cluster-url>/?retryWrites=true&w=majority&appName=BuildTogether
MONGODB_DB=buildtogether

# Authentication
# Use local while developing; change to resend after verifying a sending domain.
AUTH_EMAIL_MODE=local
RESEND_API_KEY=
AUTH_EMAIL_FROM="BuildTogether <onboarding@resend.dev>"
MONGODB_ADMIN_EMAIL=your.real.email@byui.edu
